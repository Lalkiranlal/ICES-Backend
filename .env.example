# CloudNet ICES Backend Configuration
ENVIRONMENT=development
DEBUG=true

# Database Connection (Neon PostgreSQL or SQLite)
# DATABASE_URL=postgresql+asyncpg://user:password@ep-your-db.aws.neon.tech/neondb?sslmode=require
# Or local zero-config SQLite:
DATABASE_URL=sqlite+aiosqlite:///./ices.db

# Google Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-1.5-flash

# Security Admin Notifications & Threshold
SECURITY_ADMIN_EMAIL=admin@yourdomain.com
NOTIFY_USER_ON_QUARANTINE=true
AUTO_REMEDIATION_THRESHOLD=80

# Frontend URL
FRONTEND_URL=http://localhost:3000
REPORT_CALLBACK_URL=http://localhost:8000/api/v1/remediation/report-phish
